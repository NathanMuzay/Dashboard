# PostgreSQL local (doit correspondre au mot de passe de docker-compose.yml)
POSTGRES_PASSWORD=lumi-local
DATABASE_URL=postgres://lumi:lumi-local@127.0.0.1:5432/lumi
LUMI_SEED_DEMO=false

# E-mails locaux capturés par Mailpit : http://localhost:8025
APP_URL=http://localhost:5174
MAIL_FROM="Lumi <noreply@lumi.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=local
# Pour un fournisseur réel : SMTP_SECURITY=starttls (587) ou tls (465), APP_URL=https://...
SMTP_USERNAME=
SMTP_PASSWORD=

# Configuration facultative du compte de démonstration backend.
LUMI_DEMO_EMAIL=demo@lumi.local
# Générer un hash bcrypt et ne jamais inscrire le mot de passe en clair ici.
LUMI_DEMO_PASSWORD_HASH=

# Spotify Web API Client ID pour le flux PKCE frontend
VITE_SPOTIFY_CLIENT_ID=

# Google Calendar : identifiant OAuth public de type Application Web (aucun secret client)
VITE_GOOGLE_CLIENT_ID=135253614664-htp965jejnb4chf9edg8usp88239rvp3.apps.googleusercontent.com

# Origine des liens e-mail dans la stack Docker
DOCKER_APP_URL=http://localhost:8080

# Connexion à Lumi avec Google (même client Web autorisé chez Google)
GOOGLE_OIDC_CLIENT_ID=

# Assistant Mistral : créer une clé dans https://console.mistral.ai (API Keys)
# Clé privée côté backend uniquement (ne pas utiliser de préfixe VITE_).
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-2512

# Variante Gmail : remplacer les valeurs SMTP ci-dessus dans .env.
# Activer la validation en deux étapes Google et créer un mot de passe d’application.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=votre.adresse@gmail.com
# SMTP_PASSWORD=mot_de_passe_application_sans_espaces
# MAIL_FROM="Lumi <votre.adresse@gmail.com>"
# APP_URL=http://127.0.0.1:5174
